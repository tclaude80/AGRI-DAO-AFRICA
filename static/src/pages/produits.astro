---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Nos Produits"
  description="Découvrez la gamme de produits KFTM Green : farine de banane plantain Mère Anto, biscuits Croquant de Plantain nature et chocolat. 100% naturels, sans gluten."
>
  <Header slot="header" currentPath="/produits" />

  <!-- Hero Banner -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-aos="fade-up">
        <span class="page-badge">Notre gamme</span>
        <h1>Nos Produits</h1>
        <p>Des produits 100% naturels à base de banane plantain, élaborés avec passion.</p>
      </div>
    </div>
  </section>

  <!-- Product Intro -->
  <section class="section">
    <div class="container">
      <div class="intro-content text-center" data-aos="fade-up">
        <h2>Une gamme pensée pour votre bien-être</h2>
        <p>
          Chez KFTM Green, nous transformons la banane plantain en produits savoureux
          et nutritifs. Sans gluten, sans additifs, nos produits sont élaborés dans
          le respect de la tradition et des normes de qualité les plus strictes.
        </p>
        <div class="product-certifs">
          <span class="certif"><span class="certif-icon">&#10003;</span> Sans Gluten</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> 100% Naturel</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> Sans Conservateurs</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> Made in Cameroon</span>
        </div>

        <!-- Certification ANOR -->
        <div class="anor-certification" data-aos="fade-up" data-aos-delay="200">
          <div class="anor-badge">
            <img src="/images/certifications/anor-logo.png" alt="ANOR - Agence des Normes et de la Qualité" onerror="this.style.display='none'">
            <div class="anor-text">
              <strong>Certifié ANOR</strong>
              <span>Agence des Normes et de la Qualité du Cameroun</span>
            </div>
          </div>
        </div>

        <!-- Download Catalog Button -->
        <div class="catalog-download" data-aos="fade-up" data-aos-delay="300">
          <a href="/documents/catalogue-produits-kftm.pdf" class="btn btn-primary btn-lg" download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Télécharger le Catalogue Produits (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Farine Mère Anto -->
  <section class="section bg-light" id="farine">
    <div class="container">
      <div class="product-detail">
        <div class="product-images" data-aos="fade-right">
          <div class="main-image">
            <img src="/images/produits/farine-mere-anto-1kg.jpg" alt="Farine de banane plantain Mère Anto KFTM Green 1kg" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-green">Sans Gluten</span>
            <span class="badge badge-gold">Certifié ANOR</span>
            <span class="badge badge-primary">1 kg</span>
          </div>
          <div class="product-gallery">
            <img src="/images/produits/farine-poudre.jpg" alt="Farine de plantain en poudre" loading="lazy">
            <img src="/images/produits/farine-biscuits-formes.jpg" alt="Biscuits réalisés avec la farine Mère Anto" loading="lazy">
          </div>
        </div>

        <div class="product-info" data-aos="fade-left">
          <span class="product-brand">KFTM Green</span>
          <h2>Farine de Banane Plantain<br><span class="brand-highlight">"Mère Anto"</span></h2>

          <p class="product-description">
            Poudre fine essentiellement à base de banane-plantain, facile à digérer.
            Se consomme seule en couscous ou fufu, ou en mélange avec d'autres farines
            pour réaliser des pâtisseries exquises : pain, crêpes, gâteaux et différentes
            préparations sucrées et salées. Sa texture en fait un accompagnement en garnitures
            savoureuses pour égayer vos plats de viande, poisson et légume. Sert à épaissir
            les sauces, crèmes, smoothies...
          </p>

          <div class="health-benefits">
            <span class="health-tag">Recommandée aux personnes allergiques au gluten</span>
            <span class="health-tag">Idéale en cas de surpoids</span>
            <span class="health-tag">Adaptée aux diabétiques</span>
          </div>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <div>
                <h4>100% Banane Plantain</h4>
                <p>Aucun additif, conservateur ou agent de texture</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </div>
              <div>
                <h4>Certifié Sans Gluten</h4>
                <p>Idéal pour les personnes intolérantes</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </div>
              <div>
                <h4>Riche en Nutriments</h4>
                <p>Fibres, potassium, vitamines B6 et C</p>
              </div>
            </div>
          </div>

          <!-- Valeurs Nutritionnelles -->
          <div class="nutrition-facts">
            <h4>Déclarations Nutritionnelles (pour 100g)</h4>
            <div class="nutrition-grid">
              <div class="nutrition-item">
                <span class="nutrition-value">437 kJ</span>
                <span class="nutrition-label">Énergie</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">105 g</span>
                <span class="nutrition-label">Glucides</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">0.35 g</span>
                <span class="nutrition-label">Matières grasses</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">3 g</span>
                <span class="nutrition-label">Fibres</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">5 g</span>
                <span class="nutrition-label">Protéines</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">0 g</span>
                <span class="nutrition-label">Gluten</span>
              </div>
            </div>
            <p class="composition"><strong>Composition :</strong> 100% Plantain - Humidité: 10.7%/7.2% - Cendres: 2.2%/2.1%</p>
          </div>

          <div class="usage-section">
            <h4>Utilisations recommandées</h4>
            <ul class="usage-list">
              <li>Bouillies nutritives pour bébés et adultes</li>
              <li>Pâtisserie : gâteaux, crêpes, pancakes</li>
              <li>Épaississant pour sauces et soupes</li>
              <li>Préparations culinaires traditionnelles</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=farine-mere-anto" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Croquant de Plantain -->
  <section class="section" id="biscuits">
    <div class="container">
      <div class="product-detail product-detail-reverse">
        <div class="product-images" data-aos="fade-left">
          <div class="main-image">
            <img src="/images/produits/croquant-nature-500g.jpg" alt="Croquant de Plantain biscuit nature KFTM Green 500g" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-green">Sans Colorants</span>
            <span class="badge badge-gold">Sans Conservateurs</span>
            <span class="badge badge-primary">500 g</span>
          </div>
        </div>

        <div class="product-info" data-aos="fade-right">
          <span class="product-brand">KFTM Green</span>
          <h2>Croquant de Plantain<br><span class="brand-highlight">Biscuit Nature</span></h2>

          <p class="product-description">
            Biscuit original à base de farine de plantain, idéal pour tous les âges en goûter,
            apéritif ou snack accompagné d'un thé, d'un café ou d'un yaourt.
            Le «Croquant de plantain» est un délice pour les papilles gustatives.
          </p>

          <div class="product-formats">
            <span class="format-tag">Disponible en 500 g</span>
            <span class="format-tag">Disponible en 100 g</span>
          </div>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2a10 10 0 1 0 10 10H12V2z"/>
                  <path d="M20.91 11A10 10 0 0 0 13 2.09"/>
                </svg>
              </div>
              <div>
                <h4>Base Farine de Plantain</h4>
                <p>Élaborés avec notre farine "Mère Anto"</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
              <div>
                <h4>Sans Conservateurs</h4>
                <p>Recette artisanale traditionnelle</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              </div>
              <div>
                <h4>Goût Unique</h4>
                <p>Saveur authentique du plantain</p>
              </div>
            </div>
          </div>

          <!-- Valeurs Nutritionnelles Croquant Nature -->
          <div class="nutrition-facts">
            <h4>Déclarations Nutritionnelles (pour 100g)</h4>
            <div class="nutrition-grid">
              <div class="nutrition-item">
                <span class="nutrition-value">1279,8 kJ</span>
                <span class="nutrition-label">Énergie</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">73,5 g</span>
                <span class="nutrition-label">Glucides</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">15 g</span>
                <span class="nutrition-label">Matières grasses</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">2,1 g</span>
                <span class="nutrition-label">Fibres</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">8 g</span>
                <span class="nutrition-label">Protéines</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">3%</span>
                <span class="nutrition-label">Humidité</span>
              </div>
            </div>
            <p class="composition"><strong>Ingrédients :</strong> Farine de Banane plantain, Farine de Blé T65, Sucre, Beurre, Œuf, Lait, Levure, Aromes.</p>
          </div>

          <div class="usage-section">
            <h4>Moments de dégustation</h4>
            <ul class="usage-list">
              <li>Petit-déjeuner ou goûter</li>
              <li>Snack sain au bureau</li>
              <li>Accompagnement du thé ou café</li>
              <li>Pause gourmande en famille</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=croquant-nature" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Croquant Choco -->
  <section class="section bg-light" id="biscuits-choco">
    <div class="container">
      <div class="product-detail">
        <div class="product-images" data-aos="fade-right">
          <div class="main-image">
            <img src="/images/produits/croquant-choco-500g.jpg" alt="Croquant de Plantain Choco biscuit chocolat KFTM Green 500g" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-brown">Chocolat</span>
            <span class="badge badge-green">Sans Colorants</span>
            <span class="badge badge-primary">500 g</span>
          </div>
        </div>

        <div class="product-info" data-aos="fade-left">
          <span class="product-brand">KFTM Green</span>
          <h2>Croquant de Plantain<br><span class="brand-highlight">Choco</span></h2>

          <p class="product-description">
            Biscuit original à base de farine de plantain, idéal pour tous les âges en goûter,
            apéritif ou snack accompagné d'un thé, d'un café ou d'un yaourt.
            Le «Croquant de plantain Choco» est un délice pour les papilles gustatives,
            alliant la richesse du plantain avec l'irrésistible saveur du cacao.
          </p>

          <div class="product-formats">
            <span class="format-tag">Disponible en 500 g</span>
            <span class="format-tag">Disponible en 100 g</span>
          </div>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <line x1="9" y1="9" x2="9.01" y2="9"/>
                  <line x1="15" y1="9" x2="15.01" y2="9"/>
                </svg>
              </div>
              <div>
                <h4>Plantain + Cacao</h4>
                <p>Alliance parfaite entre nutrition et gourmandise</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div>
                <h4>Pour Toute la Famille</h4>
                <p>Apprécié des petits et des grands</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <path d="M12 8v8"/>
                  <path d="M8 12h8"/>
                </svg>
              </div>
              <div>
                <h4>Nouveauté 2024</h4>
                <p>Dernière création de notre gamme</p>
              </div>
            </div>
          </div>

          <!-- Valeurs Nutritionnelles Croquant Choco -->
          <div class="nutrition-facts">
            <h4>Déclarations Nutritionnelles (pour 100g)</h4>
            <div class="nutrition-grid">
              <div class="nutrition-item">
                <span class="nutrition-value">1279,8 kJ</span>
                <span class="nutrition-label">Énergie</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">73,5 g</span>
                <span class="nutrition-label">Glucides</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">15 g</span>
                <span class="nutrition-label">Matières grasses</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">2,1 g</span>
                <span class="nutrition-label">Fibres</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">8 g</span>
                <span class="nutrition-label">Protéines</span>
              </div>
              <div class="nutrition-item">
                <span class="nutrition-value">3%</span>
                <span class="nutrition-label">Humidité</span>
              </div>
            </div>
            <p class="composition"><strong>Ingrédients :</strong> Farine de Banane plantain, Farine de Blé T65, Sucre, Beurre, Œuf, Lait, Levure, Aromes, Poudre de cacao.</p>
          </div>

          <div class="usage-section">
            <h4>Idéal pour</h4>
            <ul class="usage-list">
              <li>Goûter des enfants</li>
              <li>Pause chocolatée saine</li>
              <li>Dessert léger</li>
              <li>Snack gourmand</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=croquant-choco" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Products -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Bientôt disponible</span>
        <h2>Nos prochaines créations</h2>
        <p>Notre équipe R&D travaille sur de nouveaux produits innovants.</p>
      </div>

      <div class="coming-soon-grid">
        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="100">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
              <line x1="6" y1="1" x2="6" y2="4"/>
              <line x1="10" y1="1" x2="10" y2="4"/>
              <line x1="14" y1="1" x2="14" y2="4"/>
            </svg>
          </div>
          <h3>Chips de Plantain</h3>
          <p>Chips croustillantes de banane plantain, parfaites pour l'apéritif.</p>
          <span class="coming-badge">En développement</span>
        </div>

        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="200">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            </svg>
          </div>
          <h3>Bouillie instantanée</h3>
          <p>Préparation rapide pour bouillie de plantain, prête en 2 minutes.</p>
          <span class="coming-badge">En développement</span>
        </div>

        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="300">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3>Gamme Bio</h3>
          <p>Produits certifiés biologiques pour les marchés premium.</p>
          <span class="coming-badge">Projet 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-cta bg-gradient">
    <div class="container">
      <div class="cta-content text-center" data-aos="fade-up">
        <h2>Intéressé par nos produits ?</h2>
        <p>Contactez-nous pour passer commande ou devenir distributeur KFTM Green.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-accent btn-lg">Nous contacter</a>
          <a href="/export" class="btn btn-secondary btn-lg">Export & Distribution</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(100px + var(--spacing-4xl)) 0 var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-white);
  }

  .page-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-white);
  }

  .page-hero p {
    font-size: var(--text-xl);
    opacity: 0.9;
    max-width: 600px;
  }

  /* Intro Content */
  .intro-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .intro-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .intro-content > p {
    color: var(--color-gray-600);
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-xl);
  }

  .product-certifs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }

  .certif {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-off-white);
    border-radius: var(--radius-full);
    font-weight: 500;
    color: var(--color-gray-700);
  }

  .certif-icon {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Section Badge */
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(76, 175, 80, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Product Detail */
  .product-detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: start;
  }

