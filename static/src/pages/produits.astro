---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Nos Produits"
  description="Découvrez la gamme de produits KFTM Green : farine de banane plantain Mère Anto, biscuits Croquant de Plantain nature et chocolat. 100% naturels, sans gluten."
>
  <Header slot="header" currentPath="/produits" />

  <!-- Hero Banner -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-aos="fade-up">
        <span class="page-badge">Notre gamme</span>
        <h1>Nos Produits</h1>
        <p>Des produits 100% naturels à base de banane plantain, élaborés avec passion.</p>
      </div>
    </div>
  </section>

  <!-- Product Intro -->
  <section class="section">
    <div class="container">
      <div class="intro-content text-center" data-aos="fade-up">
        <h2>Une gamme pensée pour votre bien-être</h2>
        <p>
          Chez KFTM Green, nous transformons la banane plantain en produits savoureux
          et nutritifs. Sans gluten, sans additifs, nos produits sont élaborés dans
          le respect de la tradition et des normes de qualité les plus strictes.
        </p>
        <div class="product-certifs">
          <span class="certif"><span class="certif-icon">&#10003;</span> Sans Gluten</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> 100% Naturel</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> Sans Conservateurs</span>
          <span class="certif"><span class="certif-icon">&#10003;</span> Made in Cameroon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Farine Mère Anto -->
  <section class="section bg-light" id="farine">
    <div class="container">
      <div class="product-detail">
        <div class="product-images" data-aos="fade-right">
          <div class="main-image">
            <img src="/images/farine-mere-anto.jpg" alt="Farine de banane plantain Mère Anto KFTM Green 1kg" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-green">Sans Gluten</span>
            <span class="badge badge-gold">Premium</span>
            <span class="badge badge-primary">1 kg</span>
          </div>
        </div>

        <div class="product-info" data-aos="fade-left">
          <span class="product-brand">KFTM Green</span>
          <h2>Farine de Banane Plantain<br><span class="brand-highlight">"Mère Anto"</span></h2>

          <p class="product-description">
            Notre farine de banane plantain <strong>"Mère Anto"</strong> est le produit phare
            de KFTM Green. Élaborée à partir de bananes plantains soigneusement sélectionnées
            et transformées selon un processus rigoureux, elle offre une alternative nutritive
            et sans gluten aux farines traditionnelles.
          </p>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <div>
                <h4>100% Banane Plantain</h4>
                <p>Aucun additif, conservateur ou agent de texture</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </div>
              <div>
                <h4>Certifié Sans Gluten</h4>
                <p>Idéal pour les personnes intolérantes</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </div>
              <div>
                <h4>Riche en Nutriments</h4>
                <p>Fibres, potassium, vitamines B6 et C</p>
              </div>
            </div>
          </div>

          <div class="usage-section">
            <h4>Utilisations recommandées</h4>
            <ul class="usage-list">
              <li>Bouillies nutritives pour bébés et adultes</li>
              <li>Pâtisserie : gâteaux, crêpes, pancakes</li>
              <li>Épaississant pour sauces et soupes</li>
              <li>Préparations culinaires traditionnelles</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=farine-mere-anto" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Croquant de Plantain -->
  <section class="section" id="biscuits">
    <div class="container">
      <div class="product-detail product-detail-reverse">
        <div class="product-images" data-aos="fade-left">
          <div class="main-image">
            <img src="/images/croquant-plantain.jpg" alt="Croquant de Plantain biscuit nature KFTM Green 500g" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-green">Artisanal</span>
            <span class="badge badge-primary">500 g</span>
          </div>
        </div>

        <div class="product-info" data-aos="fade-right">
          <span class="product-brand">KFTM Green</span>
          <h2>Croquant de Plantain<br><span class="brand-highlight">Biscuit Nature</span></h2>

          <p class="product-description">
            Nos biscuits <strong>"Croquant de Plantain"</strong> sont une délicieuse façon
            de profiter des bienfaits de la banane plantain. Croquants et savoureux, ils
            constituent un snack sain pour toute la famille.
          </p>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2a10 10 0 1 0 10 10H12V2z"/>
                  <path d="M20.91 11A10 10 0 0 0 13 2.09"/>
                </svg>
              </div>
              <div>
                <h4>Base Farine de Plantain</h4>
                <p>Élaborés avec notre farine "Mère Anto"</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
              <div>
                <h4>Sans Conservateurs</h4>
                <p>Recette artisanale traditionnelle</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              </div>
              <div>
                <h4>Goût Unique</h4>
                <p>Saveur authentique du plantain</p>
              </div>
            </div>
          </div>

          <div class="usage-section">
            <h4>Moments de dégustation</h4>
            <ul class="usage-list">
              <li>Petit-déjeuner ou goûter</li>
              <li>Snack sain au bureau</li>
              <li>Accompagnement du thé ou café</li>
              <li>Pause gourmande en famille</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=croquant-nature" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product: Croquant Choco -->
  <section class="section bg-light" id="biscuits-choco">
    <div class="container">
      <div class="product-detail">
        <div class="product-images" data-aos="fade-right">
          <div class="main-image">
            <img src="/images/croquant-choco.jpg" alt="Croquant de Plantain Choco biscuit chocolat KFTM Green 500g" loading="lazy">
          </div>
          <div class="product-badges-detail">
            <span class="badge badge-brown">Chocolat</span>
            <span class="badge badge-green">Nouveau</span>
            <span class="badge badge-primary">500 g</span>
          </div>
        </div>

        <div class="product-info" data-aos="fade-left">
          <span class="product-brand">KFTM Green</span>
          <h2>Croquant de Plantain<br><span class="brand-highlight">Choco</span></h2>

          <p class="product-description">
            La gourmandise rencontre la nutrition ! Nos biscuits <strong>"Croquant de Plantain Choco"</strong>
            combinent la richesse de la farine de plantain avec l'irrésistible saveur du cacao,
            pour un plaisir sain et gourmand.
          </p>

          <div class="product-highlights">
            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <line x1="9" y1="9" x2="9.01" y2="9"/>
                  <line x1="15" y1="9" x2="15.01" y2="9"/>
                </svg>
              </div>
              <div>
                <h4>Plantain + Cacao</h4>
                <p>Alliance parfaite entre nutrition et gourmandise</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div>
                <h4>Pour Toute la Famille</h4>
                <p>Apprécié des petits et des grands</p>
              </div>
            </div>

            <div class="highlight">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <path d="M12 8v8"/>
                  <path d="M8 12h8"/>
                </svg>
              </div>
              <div>
                <h4>Nouveauté 2024</h4>
                <p>Dernière création de notre gamme</p>
              </div>
            </div>
          </div>

          <div class="usage-section">
            <h4>Idéal pour</h4>
            <ul class="usage-list">
              <li>Goûter des enfants</li>
              <li>Pause chocolatée saine</li>
              <li>Dessert léger</li>
              <li>Snack gourmand</li>
            </ul>
          </div>

          <div class="product-actions">
            <a href="/contact?product=croquant-choco" class="btn btn-primary btn-lg">Commander</a>
            <a href="/contact?type=distributor" class="btn btn-secondary">Devenir distributeur</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Products -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Bientôt disponible</span>
        <h2>Nos prochaines créations</h2>
        <p>Notre équipe R&D travaille sur de nouveaux produits innovants.</p>
      </div>

      <div class="coming-soon-grid">
        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="100">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
              <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
              <line x1="6" y1="1" x2="6" y2="4"/>
              <line x1="10" y1="1" x2="10" y2="4"/>
              <line x1="14" y1="1" x2="14" y2="4"/>
            </svg>
          </div>
          <h3>Chips de Plantain</h3>
          <p>Chips croustillantes de banane plantain, parfaites pour l'apéritif.</p>
          <span class="coming-badge">En développement</span>
        </div>

        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="200">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            </svg>
          </div>
          <h3>Bouillie instantanée</h3>
          <p>Préparation rapide pour bouillie de plantain, prête en 2 minutes.</p>
          <span class="coming-badge">En développement</span>
        </div>

        <div class="coming-soon-card" data-aos="fade-up" data-aos-delay="300">
          <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3>Gamme Bio</h3>
          <p>Produits certifiés biologiques pour les marchés premium.</p>
          <span class="coming-badge">Projet 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-cta bg-gradient">
    <div class="container">
      <div class="cta-content text-center" data-aos="fade-up">
        <h2>Intéressé par nos produits ?</h2>
        <p>Contactez-nous pour passer commande ou devenir distributeur KFTM Green.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-accent btn-lg">Nous contacter</a>
          <a href="/export" class="btn btn-secondary btn-lg">Export & Distribution</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(100px + var(--spacing-4xl)) 0 var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-white);
  }

  .page-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-white);
  }

  .page-hero p {
    font-size: var(--text-xl);
    opacity: 0.9;
    max-width: 600px;
  }

  /* Intro Content */
  .intro-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .intro-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .intro-content > p {
    color: var(--color-gray-600);
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-xl);
  }

  .product-certifs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }

  .certif {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-off-white);
    border-radius: var(--radius-full);
    font-weight: 500;
    color: var(--color-gray-700);
  }

  .certif-icon {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Section Badge */
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(76, 175, 80, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Product Detail */
  .product-detail {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  @media (min-width: 992px) {
    .product-detail {
      grid-template-columns: 1fr 1.2fr;
    }

    .product-detail-reverse {
      direction: rtl;
    }

    .product-detail-reverse > * {
      direction: ltr;
    }
  }

  .product-images {
    position: relative;
  }

  .main-image {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-secondary));
  }

  .main-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-badges-detail {
    position: absolute;
    top: var(--spacing-lg);
    left: var(--spacing-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .badge {
    padding: 6px 14px;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
  }

  .badge-green {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .badge-gold {
    background: var(--color-accent);
    color: var(--color-gray-900);
  }

  .badge-brown {
    background: var(--color-earth);
    color: var(--color-white);
  }

  .badge-primary {
    background: var(--color-gray-900);
    color: var(--color-white);
  }

  /* Product Info */
  .product-brand {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-sm);
  }

  .product-info h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--spacing-lg);
    line-height: 1.2;
  }

  .brand-highlight {
    color: var(--color-primary);
  }

  .product-description {
    color: var(--color-gray-600);
    font-size: var(--text-lg);
    line-height: 1.8;
    margin-bottom: var(--spacing-xl);
  }

  /* Product Highlights */
  .product-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .highlight {
    display: flex;
    gap: var(--spacing-md);
  }

  .highlight-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(139, 195, 74, 0.1));
    border-radius: var(--radius-md);
    color: var(--color-primary);
  }

  .highlight-icon svg {
    width: 24px;
    height: 24px;
  }

  .highlight h4 {
    font-size: var(--text-base);
    margin-bottom: 4px;
  }

  .highlight p {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin: 0;
  }

  /* Usage Section */
  .usage-section {
    background: var(--color-off-white);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-xl);
  }

  .usage-section h4 {
    font-size: var(--text-base);
    margin-bottom: var(--spacing-md);
  }

  .usage-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }

  @media (min-width: 576px) {
    .usage-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .usage-list li {
    position: relative;
    padding-left: var(--spacing-lg);
    color: var(--color-gray-600);
    font-size: var(--text-sm);
  }

  .usage-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  /* Product Actions */
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  /* Coming Soon Section */
  .coming-soon-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .coming-soon-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .coming-soon-card {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    border: 2px dashed var(--color-gray-300);
    transition: all var(--transition-base);
  }

  .coming-soon-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-5px);
  }

  .coming-soon-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(76, 175, 80, 0.1);
    border-radius: 50%;
    color: var(--color-primary);
  }

  .coming-soon-icon svg {
    width: 36px;
    height: 36px;
  }

  .coming-soon-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-sm);
  }

  .coming-soon-card p {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-md);
  }

  .coming-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-gray-200);
    color: var(--color-gray-600);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  /* CTA Section */
  .section-cta {
    color: var(--color-white);
  }

  .section-cta h2 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .section-cta p {
    opacity: 0.9;
    margin-bottom: var(--spacing-xl);
