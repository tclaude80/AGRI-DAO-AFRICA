---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Traçabilité & Innovation"
  description="KFTM Green investit dans les technologies de traçabilité, incluant la blockchain, pour garantir la transparence totale de ses produits à base de plantain."
>
  <Header slot="header" currentPath="/tracabilite" />

  <!-- Hero Banner -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-aos="fade-up">
        <span class="page-badge">Innovation</span>
        <h1>Traçabilité & Technologies</h1>
        <p>La transparence totale, du champ à votre table, grâce aux technologies de demain.</p>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="section">
    <div class="container">
      <div class="intro-content text-center" data-aos="fade-up">
        <h2>Savoir d'où vient ce que l'on mange</h2>
        <p>
          La traçabilité est au coeur de notre engagement qualité. Chaque produit KFTM Green
          peut être retracé jusqu'à la parcelle d'origine, garantissant transparence et confiance.
        </p>
      </div>
    </div>
  </section>

  <!-- Current System -->
  <section class="section bg-light">
    <div class="container">
      <div class="traceability-grid">
        <div class="trace-content" data-aos="fade-right">
          <span class="section-badge">Système actuel</span>
          <h2>Traçabilité numérique</h2>
          <p>
            Nous avons mis en place un système de traçabilité numérique qui permet
            de suivre chaque lot de production depuis l'approvisionnement jusqu'au
            produit fini.
          </p>

          <div class="trace-features">
            <div class="trace-feature">
              <div class="trace-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <h4>Identification des lots</h4>
                <p>Chaque lot reçoit un identifiant unique dès la réception.</p>
              </div>
            </div>

            <div class="trace-feature">
              <div class="trace-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              </div>
              <div>
                <h4>Documentation complète</h4>
                <p>Enregistrement de chaque étape de transformation.</p>
              </div>
            </div>

            <div class="trace-feature">
              <div class="trace-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <line x1="3" y1="9" x2="21" y2="9"/>
                  <line x1="9" y1="21" x2="9" y2="9"/>
                </svg>
              </div>
              <div>
                <h4>Base de données</h4>
                <p>Historique consultable pour chaque produit.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="trace-visual" data-aos="fade-left">
          <div class="trace-card">
            <div class="trace-card-header">
              <span class="trace-card-label">Exemple de traçabilité</span>
              <span class="trace-card-lot">LOT #KFTM-2024-1234</span>
            </div>
            <div class="trace-card-body">
              <div class="trace-step">
                <span class="trace-step-date">15/01/2024</span>
                <span class="trace-step-event">Récolte - Parcelle #K23</span>
              </div>
              <div class="trace-step">
                <span class="trace-step-date">16/01/2024</span>
                <span class="trace-step-event">Réception - Contrôle OK</span>
              </div>
              <div class="trace-step">
                <span class="trace-step-date">17/01/2024</span>
                <span class="trace-step-event">Transformation</span>
              </div>
              <div class="trace-step">
                <span class="trace-step-date">18/01/2024</span>
                <span class="trace-step-event">Contrôle qualité - Validé</span>
              </div>
              <div class="trace-step">
                <span class="trace-step-date">19/01/2024</span>
                <span class="trace-step-event">Conditionnement</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blockchain Section -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Projet Blockchain</span>
        <h2>La traçabilité de demain</h2>
        <p>Nous développons une solution blockchain pour une transparence totale et immuable.</p>
      </div>

      <div class="blockchain-grid">
        <div class="blockchain-card" data-aos="fade-up" data-aos-delay="100">
          <div class="blockchain-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </div>
          <h3>Données immuables</h3>
          <p>
            Une fois enregistrées sur la blockchain, les données ne peuvent plus être
            modifiées, garantissant l'intégrité de l'information.
          </p>
        </div>

        <div class="blockchain-card" data-aos="fade-up" data-aos-delay="200">
          <div class="blockchain-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3>Transparence totale</h3>
          <p>
            Tous les acteurs de la chaîne (producteurs, transformateurs, distributeurs)
            peuvent accéder aux informations en temps réel.
          </p>
        </div>

        <div class="blockchain-card" data-aos="fade-up" data-aos-delay="300">
          <div class="blockchain-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h3>Confiance renforcée</h3>
          <p>
            Le consommateur peut vérifier l'authenticité et l'origine de chaque
            produit en scannant un simple QR code.
          </p>
        </div>
      </div>

      <div class="blockchain-status" data-aos="fade-up">
        <div class="status-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
          <span>Projet en cours de développement - Lancement prévu 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- R&D Section -->
  <section class="section bg-gradient section-rd">
    <div class="container">
      <div class="rd-grid">
        <div class="rd-content" data-aos="fade-right">
          <span class="section-badge section-badge-light">R&D</span>
          <h2>Innovation continue</h2>
          <p>
            Notre équipe R&D travaille sur plusieurs axes d'innovation pour améliorer
            nos produits et nos processus.
          </p>

          <ul class="rd-list">
            <li>
              <strong>Traçabilité blockchain</strong>
              <span>Développement en partenariat avec des experts tech</span>
            </li>
            <li>
              <strong>Optimisation des process</strong>
              <span>Amélioration continue des rendements et de la qualité</span>
            </li>
            <li>
              <strong>Nouveaux produits</strong>
              <span>Diversification de la gamme (chips, bouillie instantanée...)</span>
            </li>
            <li>
              <strong>Conservation naturelle</strong>
              <span>Recherche sur les méthodes de conservation sans additifs</span>
            </li>
          </ul>
        </div>

        <div class="rd-visual" data-aos="fade-left">
          <div class="rd-stats">
            <div class="rd-stat">
              <span class="rd-stat-number">3+</span>
              <span class="rd-stat-label">Projets R&D en cours</span>
            </div>
            <div class="rd-stat">
              <span class="rd-stat-number">2025</span>
              <span class="rd-stat-label">Lancement blockchain</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Avantages</span>
        <h2>Les bénéfices de la traçabilité</h2>
      </div>

      <div class="benefits-grid">
        <div class="benefit-card" data-aos="fade-up" data-aos-delay="100">
          <h4>Pour les consommateurs</h4>
          <ul>
            <li>Connaissance de l'origine des produits</li>
            <li>Confiance dans la qualité</li>
            <li>Vérification de l'authenticité</li>
            <li>Information nutritionnelle fiable</li>
          </ul>
        </div>

        <div class="benefit-card" data-aos="fade-up" data-aos-delay="200">
          <h4>Pour les producteurs</h4>
          <ul>
            <li>Valorisation de leur travail</li>
            <li>Reconnaissance de la qualité</li>
            <li>Accès à de nouveaux marchés</li>
            <li>Meilleure rémunération</li>
          </ul>
        </div>

        <div class="benefit-card" data-aos="fade-up" data-aos-delay="300">
          <h4>Pour les distributeurs</h4>
          <ul>
            <li>Garantie de provenance</li>
            <li>Argument de vente différenciant</li>
            <li>Conformité réglementaire</li>
            <li>Gestion des rappels facilitée</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="cta-box" data-aos="fade-up">
        <h2>Intéressé par notre approche innovante ?</h2>
        <p>Contactez-nous pour en savoir plus sur nos projets de traçabilité et nos partenariats technologiques.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-lg">Nous contacter</a>
          <a href="/bourse-plantain" class="btn btn-secondary btn-lg">Découvrir la Bourse du Plantain</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(100px + var(--spacing-4xl)) 0 var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-white);
  }

  .page-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-white);
  }

  .page-hero p {
    font-size: var(--text-xl);
    opacity: 0.9;
    max-width: 600px;
  }

  /* Section Badge */
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(76, 175, 80, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .section-badge-light {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  /* Intro Content */
  .intro-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .intro-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .intro-content p {
    color: var(--color-gray-600);
    font-size: var(--text-lg);
  }

  /* Traceability Grid */
  .traceability-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }

  @media (min-width: 992px) {
    .traceability-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .trace-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .trace-content > p {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-xl);
  }

  .trace-features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .trace-feature {
    display: flex;
    gap: var(--spacing-md);
  }

  .trace-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius-md);
    color: var(--color-white);
  }

  .trace-icon svg {
    width: 24px;
    height: 24px;
  }

  .trace-feature h4 {
    font-size: var(--text-base);
    margin-bottom: 4px;
  }

  .trace-feature p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin: 0;
  }

  /* Trace Card */
  .trace-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .trace-card-header {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    padding: var(--spacing-lg);
    color: var(--color-white);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .trace-card-label {
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  .trace-card-lot {
    font-family: monospace;
    font-size: var(--text-sm);
    background: rgba(255, 255, 255, 0.2);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }

  .trace-card-body {
    padding: var(--spacing-lg);
  }

  .trace-step {
    display: flex;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px dashed var(--color-gray-200);
  }

  .trace-step:last-child {
    border-bottom: none;
  }

  .trace-step-date {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    min-width: 80px;
  }

  .trace-step-event {
    font-size: var(--text-sm);
    color: var(--color-gray-700);
  }

  /* Blockchain Grid */
  .blockchain-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .blockchain-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blockchain-card {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .blockchain-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
  }

  .blockchain-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(139, 195, 74, 0.1));
    border-radius: 50%;
    color: var(--color-primary);
  }

  .blockchain-icon svg {
    width: 32px;
    height: 32px;
  }

  .blockchain-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-sm);
  }

  .blockchain-card p {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    margin: 0;
  }

  .blockchain-status {
    text-align: center;
    margin-top: var(--spacing-2xl);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-off-white);
    border-radius: var(--radius-full);
    color: var(--color-gray-700);
  }

  .status-badge svg {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
  }

  /* R&D Section */
  .section-rd {
    color: var(--color-white);
  }

  .rd-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }

  @media (min-width: 992px) {
    .rd-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .rd-content h2 {
    color: var(--color-white);
    margin-bottom: var(--spacing-lg);
  }

  .rd-content > p {
    opacity: 0.9;
    margin-bottom: var(--spacing-xl);
  }

  .rd-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rd-list li {
    padding: var(--spacing-md);
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-sm);
  }

  .rd-list li strong {
    display: block;
    margin-bottom: 4px;
  }

  .rd-list li span {
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .rd-stats {
    display: grid;
    gap: var(--spacing-lg);
  }

  .rd-stat {
    text-align: center;
    padding: var(--spacing-xl);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
  }

  .rd-stat-number {
    display: block;
    font-size: var(--text-4xl);
    font-weight: 700;
    font-family: var(--font-secondary);
    color: var(--color-accent);
  }

  .rd-stat-label {
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  /* Benefits Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .benefit-card {
    background: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .benefit-card h4 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-primary);
  }

  .benefit-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .benefit-card li {
    position: relative;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
  }

  .benefit-card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  /* CTA Box */
  .cta-box {
    background: var(--color-white);
    padding: var(--spacing-3xl);
    border-radius: var(--radius-xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .cta-box h2 {
    margin-bottom: var(--spacing-md);
  }

  .cta-box > p {
    color: var(--color-gray-600);
    max-width: 600px;
    margin: 0 auto var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }
</style>
