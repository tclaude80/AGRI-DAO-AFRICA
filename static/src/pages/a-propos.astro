---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="À propos"
  description="Découvrez l'histoire de KFTM Green SARL, entreprise camerounaise spécialisée dans la transformation de la banane plantain. Fondée en 2019 à Kribi par AWONO Landry Gaëtan et Dr. Claude TCHONKO."
>
  <Header slot="header" currentPath="/a-propos" />

  <!-- Hero Banner -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-aos="fade-up">
        <span class="page-badge">Notre histoire</span>
        <h1>À propos de KFTM Green</h1>
        <p>Une vision, une passion, une mission : valoriser la banane plantain camerounaise.</p>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="section">
    <div class="container">
      <div class="story-grid">
        <div class="story-content" data-aos="fade-right">
          <span class="section-badge">Notre histoire</span>
          <h2>De la passion à l'entreprise</h2>
          <p>
            <strong>KFTM Green SARL</strong> est née en 2019 à Kribi, au coeur du Cameroun,
            d'une vision partagée entre deux entrepreneurs passionnés par l'agriculture
            et la transformation alimentaire.
          </p>
          <p>
            Face au constat d'un gaspillage important de bananes plantains mûres et d'une
            filière peu structurée, <strong>M. AWONO Landry Gaëtan</strong> et
            <strong>Dr. Claude TCHONKO</strong> ont décidé de créer une entreprise
            capable de valoriser ce produit local en denrées alimentaires de qualité.
          </p>
          <p>
            Aujourd'hui, KFTM Green est devenue une référence dans la transformation
            de la banane plantain au Cameroun, avec une gamme de produits qui s'exporte
            progressivement à l'international.
          </p>
        </div>
        <div class="story-image" data-aos="fade-left">
          <img src="/images/office-kftm.jpg" alt="Bureau KFTM Green à Kribi" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- Founders Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Leadership</span>
        <h2>Nos co-fondateurs</h2>
        <p>Des parcours complémentaires au service d'une vision commune.</p>
      </div>

      <div class="founders-grid">
        <div class="founder-card" data-aos="fade-up" data-aos-delay="100">
          <div class="founder-image">
            <img src="/images/founder-awono.jpg" alt="M. AWONO Landry Gaëtan, co-fondateur de KFTM Green" loading="lazy">
          </div>
          <div class="founder-content">
            <h3>M. AWONO Landry Gaëtan</h3>
            <span class="founder-role">Co-fondateur & Directeur Général</span>
            <p>
              Entrepreneur visionnaire avec une expertise dans le développement
              d'entreprises agricoles. Passionné par l'innovation et la valorisation
              des produits locaux camerounais.
            </p>
          </div>
        </div>

        <div class="founder-card" data-aos="fade-up" data-aos-delay="200">
          <div class="founder-image">
            <img src="/images/founder-tchonko.jpg" alt="Dr. Claude TCHONKO, co-fondateur de KFTM Green" loading="lazy">
          </div>
          <div class="founder-content">
            <h3>Dr. Claude TCHONKO</h3>
            <span class="founder-role">Co-fondateur & Directeur Technique</span>
            <p>
              Docteur en sciences alimentaires avec une expertise en transformation
              agroalimentaire. Garant de la qualité et de l'innovation des produits
              KFTM Green.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Section -->
  <section class="section">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-card" data-aos="fade-up" data-aos-delay="100">
          <div class="mission-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 16v-4M12 8h.01"/>
            </svg>
          </div>
          <h3>Notre Mission</h3>
          <p>
            Transformer la banane plantain camerounaise en produits alimentaires
            de haute qualité, tout en soutenant les producteurs locaux et en
            adoptant des pratiques durables.
          </p>
        </div>

        <div class="mission-card" data-aos="fade-up" data-aos-delay="200">
          <div class="mission-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <h3>Notre Vision</h3>
          <p>
            Devenir le leader africain de la transformation du plantain, en créant
            une filière structurée et transparente, de la ferme au consommateur,
            grâce aux technologies de traçabilité modernes.
          </p>
        </div>

        <div class="mission-card" data-aos="fade-up" data-aos-delay="300">
          <div class="mission-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3>Nos Valeurs</h3>
          <p>
            Qualité, innovation, durabilité et responsabilité sociale sont les
            piliers qui guident chacune de nos actions et décisions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section bg-gradient section-values">
    <div class="container">
      <div class="section-title text-white" data-aos="fade-up">
        <span class="section-badge section-badge-light">Nos engagements</span>
        <h2>Ce qui nous anime</h2>
      </div>

      <div class="values-grid">
        <div class="value-item" data-aos="fade-up" data-aos-delay="100">
          <div class="value-number">01</div>
          <h4>Qualité Premium</h4>
          <p>Des produits 100% naturels, sans additifs, avec un contrôle rigoureux à chaque étape.</p>
        </div>

        <div class="value-item" data-aos="fade-up" data-aos-delay="200">
          <div class="value-number">02</div>
          <h4>Impact Local</h4>
          <p>Soutien aux producteurs locaux et création d'emplois dans la région de Kribi.</p>
        </div>

        <div class="value-item" data-aos="fade-up" data-aos-delay="300">
          <div class="value-number">03</div>
          <h4>Lutte Anti-Gaspillage</h4>
          <p>Valorisation des plantains mûrs qui seraient autrement perdus.</p>
        </div>

        <div class="value-item" data-aos="fade-up" data-aos-delay="400">
          <div class="value-number">04</div>
          <h4>Innovation Continue</h4>
          <p>R&D permanente pour améliorer nos process et développer de nouveaux produits.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Notre parcours</span>
        <h2>Les étapes clés</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item" data-aos="fade-right">
          <div class="timeline-marker">2019</div>
          <div class="timeline-content">
            <h4>Création de KFTM Green SARL</h4>
            <p>Enregistrement officiel de l'entreprise à Kribi, Cameroun.</p>
          </div>
        </div>

        <div class="timeline-item" data-aos="fade-left">
          <div class="timeline-marker">2020</div>
          <div class="timeline-content">
            <h4>Lancement de "Mère Anto"</h4>
            <p>Première production de farine de banane plantain.</p>
          </div>
        </div>

        <div class="timeline-item" data-aos="fade-right">
          <div class="timeline-marker">2021</div>
          <div class="timeline-content">
            <h4>Extension de la gamme</h4>
            <p>Lancement des biscuits "Croquant de Plantain".</p>
          </div>
        </div>

        <div class="timeline-item" data-aos="fade-left">
          <div class="timeline-marker">2022</div>
          <div class="timeline-content">
            <h4>Nouveaux bureaux</h4>
            <p>Inauguration de nos nouveaux locaux à Kribi.</p>
          </div>
        </div>

        <div class="timeline-item" data-aos="fade-right">
          <div class="timeline-marker">2023</div>
          <div class="timeline-content">
            <h4>Projet Blockchain</h4>
            <p>Début du développement de la traçabilité blockchain.</p>
          </div>
        </div>

        <div class="timeline-item" data-aos="fade-left">
          <div class="timeline-marker">2024</div>
          <div class="timeline-content">
            <h4>Bourse du Plantain</h4>
            <p>Conception de la plateforme de mise en relation de la filière.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-cta bg-light">
    <div class="container">
      <div class="cta-box" data-aos="fade-up">
        <h2>Rejoignez l'aventure KFTM Green</h2>
        <p>Que vous soyez producteur, distributeur ou investisseur, découvrez comment collaborer avec nous.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-lg">Nous contacter</a>
          <a href="/filiere" class="btn btn-secondary btn-lg">Rejoindre la filière</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(100px + var(--spacing-4xl)) 0 var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-white);
  }

  .page-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-white);
  }

  .page-hero p {
    font-size: var(--text-xl);
    opacity: 0.9;
    max-width: 600px;
  }

  /* Story Section */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }

  @media (min-width: 992px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .story-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .story-content p {
    color: var(--color-gray-600);
    line-height: 1.8;
  }

  .story-image img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  /* Section Badge */
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(76, 175, 80, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .section-badge-light {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  /* Founders Section */
  .founders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .founders-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .founder-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base);
  }

  .founder-card:hover {
    transform: translateY(-5px);
  }

  .founder-image {
    height: 300px;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-secondary));
  }

  .founder-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder-content {
    padding: var(--spacing-xl);
  }

  .founder-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-xs);
  }

  .founder-role {
    display: block;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .founder-content p {
    color: var(--color-gray-600);
    margin: 0;
  }

  /* Mission Grid */
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .mission-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .mission-card {
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .mission-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
  }

  .mission-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 50%;
    color: var(--color-white);
  }

  .mission-icon svg {
    width: 36px;
    height: 36px;
  }

  .mission-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-md);
  }

  .mission-card p {
    color: var(--color-gray-600);
    margin: 0;
  }

  /* Values Section */
  .section-values .section-title h2 {
    color: var(--color-white);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 576px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .values-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .value-item {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    padding: var(--spacing-xl);
    color: var(--color-white);
    transition: all var(--transition-base);
  }

  .value-item:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-5px);
  }

  .value-number {
    font-size: var(--text-3xl);
    font-weight: 700;
    font-family: var(--font-secondary);
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
  }

  .value-item h4 {
    font-size: var(--text-lg);
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }

  .value-item p {
    font-size: var(--text-sm);
    opacity: 0.9;
    margin: 0;
  }

  /* Timeline */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding-left: 50px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-secondary));
    border-radius: 2px;
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--spacing-2xl);
  }

  .timeline-marker {
    position: absolute;
    left: -50px;
    top: 0;
    width: 35px;
    height: 35px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 700;
    box-shadow: 0 0 0 4px var(--color-white), var(--shadow-md);
  }

  .timeline-content {
    background: var(--color-white);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .timeline-content h4 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-sm);
  }

  .timeline-content p {
    color: var(--color-gray-600);
    margin: 0;
  }

  /* CTA Section */
  .cta-box {
    background: var(--color-white);
    padding: var(--spacing-3xl);
    border-radius: var(--radius-xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .cta-box h2 {
    margin-bottom: var(--spacing-md);
  }

  .cta-box > p {
    color: var(--color-gray-600);
    max-width: 600px;
    margin: 0 auto var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }
</style>
