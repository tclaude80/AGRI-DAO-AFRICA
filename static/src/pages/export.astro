---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Export & Partenariats"
  description="KFTM Green exporte ses produits à base de plantain vers l'international. Découvrez nos opportunités de partenariat B2B pour distributeurs et importateurs."
>
  <Header slot="header" currentPath="/export" />

  <!-- Hero Banner -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-content" data-aos="fade-up">
        <span class="page-badge">B2B</span>
        <h1>Export & Partenariats</h1>
        <p>Distribuez les produits KFTM Green dans votre pays. Devenez notre partenaire.</p>
      </div>
    </div>
  </section>

  <!-- Export Intro -->
  <section class="section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-content" data-aos="fade-right">
          <span class="section-badge">Notre ambition</span>
          <h2>Exporter le meilleur du Cameroun</h2>
          <p>
            KFTM Green ambitionne de faire connaître la qualité des produits à base
            de banane plantain camerounaise au-delà des frontières. Nous recherchons
            des partenaires distributeurs et importateurs pour développer notre présence
            à l'international.
          </p>
          <p>
            Nos produits, naturels et sans gluten, répondent aux attentes des marchés
            internationaux en quête d'alternatives saines et authentiques.
          </p>
        </div>
        <div class="intro-visual" data-aos="fade-left">
          <div class="intro-stats">
            <div class="intro-stat">
              <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </span>
              <span class="stat-label">Export international</span>
            </div>
            <div class="intro-stat">
              <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </span>
              <span class="stat-label">Qualité certifiée</span>
            </div>
            <div class="intro-stat">
              <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </span>
              <span class="stat-label">Partenariats durables</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products for Export -->
  <section class="section bg-light">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Notre gamme</span>
        <h2>Produits disponibles à l'export</h2>
      </div>

      <div class="export-products">
        <div class="export-product" data-aos="fade-up" data-aos-delay="100">
          <div class="product-image">
            <img src="/images/farine-mere-anto.jpg" alt="Farine de plantain Mère Anto pour export" loading="lazy">
          </div>
          <div class="product-info">
            <h3>Farine "Mère Anto"</h3>
            <p>Farine de banane plantain 100% naturelle, sans gluten.</p>
            <ul class="product-specs">
              <li><strong>Format:</strong> 1 kg</li>
              <li><strong>Conservation:</strong> 12 mois</li>
              <li><strong>Minimum:</strong> 500 unités</li>
            </ul>
          </div>
        </div>

        <div class="export-product" data-aos="fade-up" data-aos-delay="200">
          <div class="product-image">
            <img src="/images/croquant-plantain.jpg" alt="Biscuits Croquant de Plantain pour export" loading="lazy">
          </div>
          <div class="product-info">
            <h3>Croquant de Plantain</h3>
            <p>Biscuits croustillants à base de farine de plantain.</p>
            <ul class="product-specs">
              <li><strong>Format:</strong> 500 g</li>
              <li><strong>Conservation:</strong> 6 mois</li>
              <li><strong>Minimum:</strong> 300 unités</li>
            </ul>
          </div>
        </div>

        <div class="export-product" data-aos="fade-up" data-aos-delay="300">
          <div class="product-image">
            <img src="/images/croquant-choco.jpg" alt="Biscuits Croquant Choco pour export" loading="lazy">
          </div>
          <div class="product-info">
            <h3>Croquant Choco</h3>
            <p>Biscuits au plantain et cacao, saveur gourmande.</p>
            <ul class="product-specs">
              <li><strong>Format:</strong> 500 g</li>
              <li><strong>Conservation:</strong> 6 mois</li>
              <li><strong>Minimum:</strong> 300 unités</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership Types -->
  <section class="section">
    <div class="container">
      <div class="section-title" data-aos="fade-up">
        <span class="section-badge">Partenariats</span>
        <h2>Types de collaboration</h2>
      </div>

      <div class="partnership-grid">
        <div class="partnership-card" data-aos="fade-up" data-aos-delay="100">
          <div class="partnership-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h3>Distributeur</h3>
          <p>
            Vous disposez d'un réseau de distribution (supermarchés, épiceries fines,
            magasins bio) ? Devenez distributeur exclusif ou non-exclusif sur votre territoire.
          </p>
          <ul class="partnership-benefits">
            <li>Tarifs préférentiels</li>
            <li>Support marketing</li>
            <li>Formation produits</li>
          </ul>
        </div>

        <div class="partnership-card" data-aos="fade-up" data-aos-delay="200">
          <div class="partnership-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <h3>Importateur</h3>
          <p>
            Vous êtes importateur de produits alimentaires ? Intégrez nos produits
            à votre catalogue et bénéficiez de conditions avantageuses.
          </p>
          <ul class="partnership-benefits">
            <li>Volumes flexibles</li>
            <li>Documentation export complète</li>
            <li>Accompagnement logistique</li>
          </ul>
        </div>

        <div class="partnership-card" data-aos="fade-up" data-aos-delay="300">
          <div class="partnership-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Marque Blanche</h3>
          <p>
            Vous souhaitez commercialiser nos produits sous votre propre marque ?
            Nous pouvons étudier des partenariats de production en marque blanche.
          </p>
          <ul class="partnership-benefits">
            <li>Personnalisation packaging</li>
            <li>Volumes minimum à définir</li>
            <li>Contrat long terme</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Partner With Us -->
  <section class="section bg-gradient section-why">
    <div class="container">
      <div class="section-title text-white" data-aos="fade-up">
        <span class="section-badge section-badge-light">Pourquoi nous</span>
        <h2>Les atouts KFTM Green</h2>
      </div>

      <div class="why-grid">
        <div class="why-item" data-aos="fade-up" data-aos-delay="100">
          <div class="why-number">01</div>
          <h4>Produits uniques</h4>
          <p>Des produits authentiques à base de plantain, introuvables ailleurs.</p>
        </div>

        <div class="why-item" data-aos="fade-up" data-aos-delay="200">
          <div class="why-number">02</div>
          <h4>Sans gluten</h4>
          <p>Répondant à la demande croissante pour les produits sans gluten.</p>
        </div>

        <div class="why-item" data-aos="fade-up" data-aos-delay="300">
          <div class="why-number">03</div>
          <h4>Histoire & authenticité</h4>
          <p>Un storytelling fort : origine Cameroun, production artisanale, impact local.</p>
        </div>

        <div class="why-item" data-aos="fade-up" data-aos-delay="400">
          <div class="why-number">04</div>
          <h4>Traçabilité</h4>
          <p>Transparence totale sur l'origine et le processus de fabrication.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact for Partnership -->
  <section class="section">
    <div class="container">
      <div class="contact-export-grid">
        <div class="contact-export-content" data-aos="fade-right">
          <span class="section-badge">Contact Export</span>
          <h2>Discutons de votre projet</h2>
          <p>
            Vous êtes intéressé par la distribution de nos produits ?
            Contactez notre équipe commerciale pour étudier les possibilités
            de partenariat.
          </p>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <div>
                <span class="info-label">Email Export</span>
                <a href="mailto:infos@kftmgreen.cm">infos@kftmgreen.cm</a>
              </div>
            </div>

            <div class="contact-info-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
              <div>
                <span class="info-label">Téléphone</span>
                <a href="tel:+237654397450">+237 654 39 74 50</a>
              </div>
            </div>

            <div class="contact-info-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <div>
                <span class="info-label">Siège</span>
                <span>Kribi, Cameroun</span>
              </div>
            </div>
          </div>
        </div>

        <div class="contact-export-form" data-aos="fade-left">
          <div class="form-card">
            <h3>Demande de partenariat</h3>
            <form id="exportForm">
              <div class="form-group">
                <label for="companyName" class="form-label">Entreprise *</label>
                <input type="text" id="companyName" name="companyName" class="form-input" required>
              </div>

              <div class="form-group">
                <label for="contactName" class="form-label">Nom du contact *</label>
                <input type="text" id="contactName" name="contactName" class="form-input" required>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input type="email" id="email" name="email" class="form-input" required>
              </div>

              <div class="form-group">
                <label for="country" class="form-label">Pays *</label>
                <input type="text" id="country" name="country" class="form-input" required>
              </div>

              <div class="form-group">
                <label for="partnershipType" class="form-label">Type de partenariat *</label>
                <select id="partnershipType" name="partnershipType" class="form-select" required>
                  <option value="">Sélectionnez</option>
                  <option value="distributor">Distributeur</option>
                  <option value="importer">Importateur</option>
                  <option value="whitelabel">Marque blanche</option>
                  <option value="other">Autre</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message" class="form-label">Message</label>
                <textarea id="message" name="message" class="form-textarea" rows="4"></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg">Envoyer</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding: calc(100px + var(--spacing-4xl)) 0 var(--spacing-4xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: var(--color-white);
  }

  .page-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-white);
  }

  .page-hero p {
    font-size: var(--text-xl);
    opacity: 0.9;
    max-width: 600px;
  }

  /* Section Badge */
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(76, 175, 80, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .section-badge-light {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  /* Intro Grid */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
  }

  @media (min-width: 992px) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .intro-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .intro-content p {
    color: var(--color-gray-600);
    line-height: 1.8;
  }

  .intro-stats {
    display: grid;
    gap: var(--spacing-lg);
  }

  .intro-stat {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .stat-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius-md);
    color: var(--color-white);
  }

  .stat-icon svg {
    width: 24px;
    height: 24px;
  }

  .stat-label {
    font-weight: 600;
    color: var(--color-gray-800);
  }

  /* Export Products */
  .export-products {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .export-products {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .export-product {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .export-product:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-xl);
  }

  .export-product .product-image {
    height: 200px;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-secondary));
  }

  .export-product .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .export-product .product-info {
    padding: var(--spacing-lg);
  }

  .export-product h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-sm);
  }

  .export-product > .product-info > p {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-md);
  }

  .product-specs {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }

  .product-specs li {
    padding: var(--spacing-xs) 0;
    border-bottom: 1px dashed var(--color-gray-200);
    color: var(--color-gray-600);
  }

  .product-specs li:last-child {
    border-bottom: none;
  }

  /* Partnership Grid */
  .partnership-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .partnership-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .partnership-card {
    background: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .partnership-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
  }

  .partnership-icon {
    width: 60px;
    height: 60px;
    margin-bottom: var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius-md);
    color: var(--color-white);
  }

  .partnership-icon svg {
    width: 28px;
    height: 28px;
  }

  .partnership-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--spacing-sm);
  }

  .partnership-card > p {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-lg);
    font-size: var(--text-sm);
  }

  .partnership-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .partnership-benefits li {
    position: relative;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    font-size: var(--text-sm);
    color: var(--color-gray-700);
  }

  .partnership-benefits li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Why Section */
  .section-why .section-title h2 {
    color: var(--color-white);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-item {
    text-align: center;
    padding: var(--spacing-xl);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    color: var(--color-white);
    transition: all var(--transition-base);
  }

  .why-item:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-5px);
  }

  .why-number {
    font-size: var(--text-3xl);
    font-weight: 700;
    font-family: var(--font-secondary);
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
  }

  .why-item h4 {
    color: var(--color-white);
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-sm);
  }

  .why-item p {
    font-size: var(--text-sm);
    opacity: 0.9;
    margin: 0;
  }

  /* Contact Export Grid */
  .contact-export-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
  }

  @media (min-width: 992px) {
    .contact-export-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-export-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .contact-export-content > p {
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-xl);
  }

  .contact-info-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact-info-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .contact-info-item svg {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-bottom: 2px;
  }

  .contact-info-item a {
    color: var(--color-gray-800);
    font-weight: 500;
  }

  /* Form Card */
  .form-card {
    background: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .form-card h3 {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid var(--color-gray-200);
  }

  .form-card .btn {
    width: 100%;
  }
</style>
