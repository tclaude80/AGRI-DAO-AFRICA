---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = "KFTM Green SARL - Agro-industrie spécialisée dans la transformation de la banane plantain au Cameroun. Farine de plantain Mère Anto, biscuits artisanaux. Healthy Living, Healthy Farming.",
  image = "/images/og-image.jpg",
  canonical
} = Astro.props;

const siteUrl = "https://kftmgreen.cm";
const fullTitle = title === "Accueil" ? "KFTM Green - Healthy Living, Healthy Farming" : `${title} | KFTM Green`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle}>
  <meta name="description" content={description}>
  <meta name="author" content="KFTM Green SARL">
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="KFTM Green, plantain, banane plantain, farine plantain, Mère Anto, Cameroun, Kribi, agro-industrie, transformation alimentaire, biscuits plantain, export, agriculture durable">

  <!-- Canonical -->
  {canonical && <link rel="canonical" href={canonical}>}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#4CAF50">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${siteUrl}${image}`}>
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="KFTM Green">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={siteUrl}>
  <meta property="twitter:title" content={fullTitle}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={`${siteUrl}${image}`}>

  <!-- Schema.org -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "KFTM Green SARL",
      "alternateName": "KFTM Green",
      "url": "https://kftmgreen.cm",
      "logo": "https://kftmgreen.cm/images/logo-kftm-green.png",
      "description": "Agro-industrie spécialisée dans la transformation de la banane plantain au Cameroun",
      "foundingDate": "2019",
      "founders": [
        {
          "@type": "Person",
          "name": "AWONO Landry Gaëtan"
        },
        {
          "@type": "Person",
          "name": "Dr. Claude TCHONKO"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kribi",
        "addressCountry": "CM"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+237-654-39-74-50",
        "contactType": "customer service",
        "email": "infos@kftmgreen.cm",
        "availableLanguage": ["French", "English"]
      },
      "sameAs": [
        "https://www.facebook.com/kftmgreen",
        "https://www.linkedin.com/company/kftmgreen"
      ],
      "slogan": "Healthy Living, Healthy Farming"
    }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- AOS Animation Library -->
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
</head>
<body>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <slot name="header" />

  <main id="main-content">
    <slot />
  </main>

  <slot name="footer" />

  <!-- AOS Init -->
  <script>
    import AOS from 'aos';

    document.addEventListener('DOMContentLoaded', () => {
      AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true,
        offset: 50,
        disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches
      });
    });
  </script>

  <!-- Mobile menu toggle -->
  <script>
    const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileMenuClose = document.querySelector('.mobile-menu-close');

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      mobileMenuClose?.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
        document.body.style.overflow = '';
      });

      // Close on click outside
      mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
          mobileMenu.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    }
  </script>

  <!-- Smooth scroll for anchor links -->
  <script>
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  </script>
</body>
</html>
